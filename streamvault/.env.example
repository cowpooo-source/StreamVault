# API URL — leave empty for VPS (same-origin), set for local dev
# VITE_API_URL=http://localhost:3001

# Secure (HTTPS) app origin used as the logout/return target for direct HTTP content mode.
# Defaults to the current origin in development. Required in production.
# VITE_SECURE_APP_BASE_URL=https://media.portalheaven.stream/app

# Optional HilltopAds VAST preroll. This endpoint returns VAST XML, not a JavaScript script.
# Enable only for eligible guest/free playback accounts. Ads run on plays 1, 5, 10, 15...
VITE_VAST_URL=https://crookedagreement.com/d/m.Fxzzd_GMNwvmZoGQUo/Ue/mL9RucZiUElNkdP_TycowUMvDBgH0gOPDhUvtgNSzPApwUOzDOQH4vOgQQ

# Ad Feature Flags (set to "true" to enable)
VITE_ENABLE_VAST=false
VITE_ENABLE_ADSTERRA=false
VITE_ENABLE_HILLTOP=false
VITE_ENABLE_HILLTOP_POPUNDER=false

# HilltopAds in-page push URL. This is loaded only for eligible accounts on allowed app pages.
VITE_HILLTOP_INPAGE_PUSH_URL=https://quarrelsomebitter.com/brX.V/sedhGPlb0SY/WCcQ/iepmV9xu/ZtURlVkPP/T/c/wWMhjhAc0wNnDuEotsN/z/AdyEMhDSQF0BN_Qk

# HilltopAds popunder URL. Frequency capping is managed in the HilltopAds campaign settings.
VITE_HILLTOP_POPUNDER_URL=https://crookedagreement.com/cQDs9.6Pbw2j5Ul/ShW-QP9tN/zoMi1_NKjdIPyGMkSd0g3_MwzVUK2fMNjVIp1J

# Adsterra Social Bar URL
VITE_ADSTERRA_URL=https://pl29160027.profitablecpmratenetwork.com/fe/df/06/fedf067b01378386e9c4bc061ffa1edb.js

# Turnstile Site Key for frontend CAPTCHA
VITE_TURNSTILE_SITE_KEY=your_site_key_here

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-5NSCGC4P5M
# Enable versioned bounded Stalker catalog loading after backend staging verification.
VITE_STALKER_LAZY_CATALOG_ENABLED=false
