# Port to run the proxy on
PORT=3001

# Restrict which frontend origins can call this proxy
# Set to your StreamVault URL in production, * for local dev
ALLOWED_ORIGIN=*

# Optional: server-side TMDB v3 API key for all users and guests
TMDB_API_KEY=

# Optional: Brevo API key for account activation, password reset, and login OTP emails
BREVO_API_KEY=

# Optional: sender details for Brevo
SMTP_FROM=portalheaven.stream@gmail.com
SMTP_FROM_NAME=Portal Heaven

# Turnstile Secret Key for protecting login/registration
TURNSTILE_SECRET_KEY=your_secret_key_here

# --- Direct Content (HTTP player) ---
# The HTTP origin that serves the token-gated /content player shell.
# Bare IPs are intentional to bypass HSTS on HTTPS-only subdomains.
# Required in production. Leave unset only for local dev (defaults to http://localhost:3201).
CONTENT_BASE_URL=http://localhost:3201
# Session TTL in minutes (allowed range 5-120, default 30)
CONTENT_SESSION_TTL_MINUTES=30
# Max concurrent content sessions per user (allowed range 1-50, default 5)
CONTENT_SESSION_MAX_PER_USER=5
# Master key used to encrypt content-session connection payloads (hex, >=32 bytes)
TOKEN_MASTER_KEY=

# --- Single Sign-On (SSO) OAuth Credentials ---
# Required for Google and GitHub login strategies
OAUTH_CALLBACK_URL_BASE=http://localhost:3001
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# --- Google Analytics 4 (GA4) ---
# Measurement ID (e.g., G-XXXXXXXX)
GA_MEASUREMENT_ID=
# API Secret for Measurement Protocol (generated in GA4 Admin > Data Streams > Measurement Protocol API secrets)
GA_API_SECRET=
