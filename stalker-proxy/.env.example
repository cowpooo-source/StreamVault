# Port to run the proxy on
PORT=3001

# Restrict which frontend origins can call this proxy
# Set to your StreamVault URL in production, * for local dev
ALLOWED_ORIGIN=*

# Optional: server-side TMDB v3 API key for all users and guests
TMDB_API_KEY=

# Optional: Brevo API key for account activation, password reset, and login OTP emails
BREVO_API_KEY=

# Optional: sender details for Brevo
SMTP_FROM=portalheaven.stream@gmail.com
SMTP_FROM_NAME=Portal Heaven

# Turnstile Secret Key for protecting login/registration
TURNSTILE_SECRET_KEY=your_secret_key_here
