{
  "name": "stalker-proxy",
  "version": "1.0.0",
  "description": "CORS proxy for Stalker/Ministra IPTV portals — handles token handshake and header injection",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "docker": "cross-env PORT=3201 PLAYER_BASE=http://localhost:3201 node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --configLoader native --pool threads"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.8.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.11.3",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "vitest": "^4.1.2"
  }
}